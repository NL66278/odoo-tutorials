<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
   <t t-name="owl_playground.todo" owl="1">
       <li t-att-class="props.done ? 'text-decoration-line-through text-muted' : '' ">
           <input
                class="form-check-input"
                type="checkbox"
                t-att-id="props.id"
                t-att-checked="props.done"
                t-on-click="onClick"
            />
           <t t-esc="props.id" /> <t t-esc="props.description" />
           <span class="fa fa-remove" t-on-click="onClickRemove" t-att-id="props.id" />
       </li>
   </t>
</templates>
